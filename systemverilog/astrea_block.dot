digraph ASTREA {
    rankdir=LR;
    node [shape=box, style=filled, fillcolor=lightblue, fontname="Helvetica", fontsize=11];
    edge [fontname="Helvetica", fontsize=9];

    // Top-level
    ASTREA_MUX [label="ASTREA_MUX\n(severity mux)", fillcolor=lightyellow];

    // Submodules
    HW2 [label="HW=2\n(direct edge.f)"];
    ASTREA_HW4 [label="ASTREA_HW4\nHW=4 decoder"];
    ASTREA_HW6 [label="ASTREA_HW6\nHW=6 decoder"];

    // EDGE_ACC instances for HW4
    subgraph cluster_hw4 {
        label="ASTREA_HW4";
        style=dashed;
        color=gray;
        node [fillcolor=lightgreen];
        ACC4_0 [label="EDGE_ACC\n(N=2)\nm[0]=01+23"];
        ACC4_1 [label="EDGE_ACC\n(N=2)\nm[1]=02+13"];
        ACC4_2 [label="EDGE_ACC\n(N=2)\nm[2]=03+12"];
        CMP4 [label="Comparator Tree\n(3-way min)"];
        ACC4_0 -> CMP4 [label="m[0]"];
        ACC4_1 -> CMP4 [label="m[1]"];
        ACC4_2 -> CMP4 [label="m[2]"];
    }

    // EDGE_ACC instances for HW6
    subgraph cluster_hw6 {
        label="ASTREA_HW6";
        style=dashed;
        color=gray;
        node [fillcolor=lightgreen];
        ACC6 [label="EDGE_ACC x15\n(N=3)\nm[0..14]"];
        MEC_L1 [label="MASS_EDGE_COMPARE\nN=7 (L1)"];
        MEC_L2 [label="MASS_EDGE_COMPARE\nN=4 (L2)"];
        MEC_L3 [label="MASS_EDGE_COMPARE\nN=2 (L3)"];
        PASS [label="m[14] passthrough"];
        ACC6 -> MEC_L1 [label="m[0..13]"];
        ACC6 -> PASS [label="m[14]"];
        PASS -> MEC_L2;
        MEC_L1 -> MEC_L2 [label="7 winners"];
        MEC_L2 -> MEC_L3 [label="4 winners"];
    }

    // Inputs
    edges_in [label="edges[5:0]\n(6 edges)", shape=ellipse, fillcolor=white];
    edges_in6 [label="edges[14:0]\n(15 edges)", shape=ellipse, fillcolor=white];
    severity [label="severity[1:0]", shape=ellipse, fillcolor=white];

    // Outputs
    frame_flips [label="frame_flips\n(obs_type)", shape=ellipse, fillcolor=white];

    // Connections
    severity -> ASTREA_MUX;
    edges_in -> ASTREA_HW4;
    edges_in6 -> ASTREA_HW6;
    edges_in -> HW2 [label="edges[0].f"];

    ASTREA_HW4 -> ASTREA_MUX [label="hw4_f"];
    ASTREA_HW6 -> ASTREA_MUX [label="hw6_f"];
    HW2 -> ASTREA_MUX [label="hw2_f"];

    ASTREA_MUX -> frame_flips;

    edges_in -> ACC4_0;
    edges_in -> ACC4_1;
    edges_in -> ACC4_2;
    CMP4 -> ASTREA_HW4 [label="frame_flips"];

    edges_in6 -> ACC6;
    MEC_L3 -> ASTREA_HW6 [label="winner.f"];
}
